# -----------------------------------------------------------------------------
# Frontend (Vite) — these ship in the client bundle, so ONLY public-safe values.
# -----------------------------------------------------------------------------

# Leave both blank to run the app against the in-memory demo data (no backend
# needed). Fill them in to point at your Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Data source override: "auto" (default) uses Supabase when the two vars above
# are set, otherwise falls back to demo data. Force with "supabase" or "demo".
VITE_DATA_SOURCE=auto

# -----------------------------------------------------------------------------
# Capture edge function secrets — set via `supabase secrets set`, NOT here.
# Listed for reference only. NEVER put service_role or provider keys in a
# VITE_-prefixed var; those would leak into the browser bundle.
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=...
# CAPTURE_PROVIDER=mock            # mock | browserless | urlbox
# BROWSERLESS_URL=...
# BROWSERLESS_TOKEN=...
# URLBOX_KEY=...
# URLBOX_SECRET=...
